generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

generator dbml {
  provider = "prisma-dbml-generator"
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  isValid   Boolean  @default(true)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_token")
}

model Rating {
  id        String   @id @default(uuid()) @map("rating_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  igdbId    Int      @map("igdb_id")
  value     Float    @map("value")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, igdbId])
  @@index([igdbId])
  @@map("ratings")
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  userName        String         @unique @map("user_name")
  password        String
  hasPassword     Boolean        @default(true) @map("has_password")
  profilePicture  String?        @map("profile_picture")
  userBanner      String?        @map("user_banner")
  googleId        String?        @unique @map("google_id")
  discordId       String?        @unique @map("discord_id")
  emailVerifiedAt DateTime?      @map("email_verified_at")
  termsAcceptedAt DateTime?      @map("terms_accepted_at")
  termsVersion    String?        @map("terms_version")
  role            UserRole       @default(USER)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @default(now()) @map("updated_at")
  userGames       UserGame[]
  refreshToken    RefreshToken[]
  Rating          Rating[]
  Review          Review[]
  accounts        PlatformAccount[]
  favoriteGames   UserFavoriteGame[]
  auditLogs       AuditLog[]
  settingsEdits   AppSetting[]

  following Follow[] @relation("FollowFollower")
  followers Follow[] @relation("FollowFollowing")

  @@map("users")
}

model Follow {
  id          String   @id @default(uuid())
  follower    User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String   @map("follower_id")
  following   User     @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model UserGame {
  id                String    @id @default(uuid())
  igdbId            Int       @map("igdb_id")
  userId            String    @map("user_id")
  userGamesStatusId Int       @map("user_games_status_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  completedAt       DateTime? @map("completed_at")
  // Última vez que o jogo entrou em Larguei. Nunca é apagada e só vale enquanto
  // o status for Larguei (ver droppedAtFor).
  droppedAt         DateTime? @map("dropped_at")
  lastPlayedAt      DateTime? @map("last_played_at")
  endless           Boolean   @default(false)
  endlessLocked     Boolean   @default(false) @map("endless_locked")
  hundredPercent    Boolean   @default(false) @map("hundred_percent")
  hundredPercentLocked Boolean @default(false) @map("hundred_percent_locked")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  UserGameStats   UserGameStats?
  UserGamesStatus UserGamesStatus    @relation(fields: [userGamesStatusId], references: [id])
  platforms       UserGamePlatform[]
  suggestion      CompletionSuggestion?

  @@unique([userId, igdbId])
  @@map("user_games")
}

enum Platform {
  STEAM
  PLAYSTATION
  XBOX
  NINTENDO
  EPIC
  GOG
  OTHER
}

enum Console {
  UNKNOWN
  PS1
  PS2
  PS3
  PS4
  PS5
  PSP
  PS_VITA
  XBOX_ORIGINAL
  XBOX_360
  XBOX_ONE
  XBOX_SERIES
  NES
  SNES
  N64
  GAMECUBE
  WII
  WII_U
  SWITCH
  SWITCH_2
  GAME_BOY
  GAME_BOY_COLOR
  GAME_BOY_ADVANCE
  DS
  N3DS
  PC
  STEAM_DECK
  MASTER_SYSTEM
  MEGA_DRIVE
  SEGA_CD
  SATURN
  DREAMCAST
  GAME_GEAR
  ATARI_2600
  ATARI_7800
  NEO_GEO
  TURBOGRAFX
  MOBILE
  ARCADE
}

model UserGamePlatform {
  id          String    @id @default(uuid())
  userGameId  String    @map("user_game_id")
  platform    Platform
  console     Console   @default(UNKNOWN)
  hoursPlayed Decimal?  @map("hours_played") @db.Decimal(6, 2)
  completions Int       @default(0)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  userGame     UserGame           @relation(fields: [userGameId], references: [id], onDelete: Cascade)
  accountHours PlatformAccountHours[]

  @@unique([userGameId, platform, console])
  @@map("user_game_platforms")
}

model PlatformAccount {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  platform         Platform
  externalId       String   @map("external_id")
  displayName      String   @map("display_name")
  preferredConsole Console? @map("preferred_console")
  createdAt        DateTime @default(now()) @map("created_at")

  // Totais da loja, gravados ao fim de cada importação (nulos até a primeira
  // importação depois deste campo existir). Steam: conquistas dos jogos
  // consultados; Xbox: conquistas e gamerscore; PSN: troféus e platinas.
  achievementsEarned Int?      @map("achievements_earned")
  gamerscore         Int?
  platinumTrophies   Int?      @map("platinum_trophies")
  statsSyncedAt      DateTime? @map("stats_synced_at")

  user  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hours PlatformAccountHours[]

  @@unique([platform, externalId])
  @@index([userId, platform])
  @@map("platform_accounts")
}

model PlatformAccountHours {
  id                 String   @id @default(uuid())
  userGamePlatformId String   @map("user_game_platform_id")
  platformAccountId  String   @map("platform_account_id")
  hoursPlayed        Decimal  @map("hours_played") @db.Decimal(6, 2)
  updatedAt          DateTime @updatedAt @map("updated_at")

  userGamePlatform UserGamePlatform @relation(fields: [userGamePlatformId], references: [id], onDelete: Cascade)
  platformAccount  PlatformAccount  @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)

  @@unique([userGamePlatformId, platformAccountId])
  @@index([platformAccountId])
  @@map("platform_account_hours")
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

model CompletionSuggestion {
  id            String           @id @default(uuid())
  userGameId    String           @unique @map("user_game_id")
  platform      Platform
  status        SuggestionStatus @default(PENDING)
  evidence      Json
  lowConfidence Boolean          @default(false) @map("low_confidence")
  undoSnapshot  Json?            @map("undo_snapshot")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  resolvedAt    DateTime?        @map("resolved_at")

  userGame UserGame @relation(fields: [userGameId], references: [id], onDelete: Cascade)

  @@map("completion_suggestions")
}

model UserGamesStatus {
  id        Int        @id @default(autoincrement())
  status    Status
  userGames UserGame[]

  @@map("users_games_status")
}

enum Status {
  PLAYED
  PAUSED
  PLAYING
  BACKLOG
  WISHLIST
  DROPPED
}

model GameCache {
  igdbId               Int       @id @map("igdb_id")
  name                 String
  coverUrl             String?   @map("cover_url")
  summary              String?
  genres               String[]
  platforms            String[]
  alternativeNames     String?   @map("alternative_names")
  releaseDate          Int?      @map("release_date")
  releaseDatePrecision String?   @map("release_date_precision")
  hypes                Int?      @map("hypes")
  totalRatingCount     Int?      @map("total_rating_count")
  category             Int?      @map("category")
  parentGameId         Int?      @map("parent_game_id")
  gameModes            Int[]     @default([]) @map("game_modes")
  gameModesCheckedAt   DateTime? @map("game_modes_checked_at")
  gameStatus           Int?      @map("game_status")
  slug                 String?   @unique
  syncedAt             DateTime  @default(now()) @updatedAt @map("synced_at")

  @@index([name])
  @@index([releaseDate])
  @@index([hypes])
  @@index([totalRatingCount])
  @@index([gameStatus])
  @@map("games_cache")
}

model Review {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  igdbId    Int      @map("igdb_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, igdbId])
  @@index([igdbId])
  @@map("reviews")
}

model UserGameStats {
  id          String   @id @default(uuid())
  userGameId  String   @map("user_game_id")
  completions Int      @default(0)
  hoursPlayed Decimal? @map("hours_played") @db.Decimal(6, 2)

  userGame UserGame @relation(fields: [userGameId], references: [id], onDelete: Cascade)

  @@unique([userGameId])
  @@map("user_game_stats")
}

model UserFavoriteGame {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  igdbId    Int      @map("igdb_id")
  position  Int
  isMain    Boolean  @default(false) @map("is_main")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, igdbId])
  @@unique([userId, position])
  @@map("user_favorite_games")
}

enum UserRole {
  USER
  ADMIN
}

enum AuditArea {
  USERS
  IMPORTS
  CATALOG
  MODERATION
  SYSTEM
}

enum AuditResult {
  OK
  FAILED
}

model AuditLog {
  id        String      @id @default(uuid())
  actorId   String?     @map("actor_id")
  action    String
  area      AuditArea
  target    String?
  detail    String?
  result    AuditResult @default(OK)
  ip        String?
  createdAt DateTime    @default(now()) @map("created_at")
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([area, createdAt])
  @@map("audit_logs")
}

model AppSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("app_settings")
}
